Options -Indexes
RewriteEngine On

# مسیر پایه فایل‌های استاتیک
RewriteCond %{REQUEST_URI} !^/mo/assets/
RewriteCond %{REQUEST_URI} !^/mo/uploads/

# هدایت همه درخواست‌ها به index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?page=$1 [QSA,L]

# جلوگیری از دسترسی مستقیم به فایل‌های حساس
<FilesMatch "^(.htaccess|.git|composer.json|README.md)">
    Order deny,allow
    Deny from all
</FilesMatch>

# جلوگیری از دسترسی به پوشه‌های حساس
RedirectMatch 403 ^/mo/(config|includes|vendor)/.*$

# تنظیم هدرهای امنیتی
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>